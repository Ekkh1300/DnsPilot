<Window x:Class="DnsPilot.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:DnsPilot.Ui"
        Title="DnsPilot"
        Icon="Assets/dns-pilot.ico"
        Width="470"
        Height="706"
        MinWidth="410"
        MinHeight="540"
        Background="{DynamicResource Brush.Window}"
        Foreground="{DynamicResource Brush.Ink}"
        FontFamily="{StaticResource Font.UI}"
        FontSize="13"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">

    <!--
      A fixed small window, not a resizable workspace. Everything the app does fits in one column
      and there is no state that needs more room to be understood - the list scrolls and nothing
      else competes for height. MinHeight exists so the window can be made shorter than it opens,
      never so it can be dragged down to a stub where the Apply button disappears off the bottom.

      Foreground is deliberate and window-wide: bare TextBlocks inherit it, instead of falling to
      the SystemColors.ControlText that implicit Control styles (WPF's default ListBox style, most
      notably) stamp onto every intermediate control. That default was black text - which on the
      dark theme put the server names at black-on-dark and made them effectively invisible, while
      in light mode the mistake hid behind white paper.
    -->

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolVis" />
        <ui:InverseBoolToVisibility x:Key="InvBoolVis" />
        <ui:StringToVisibility x:Key="StrVis" />
        <ui:EmptyStringToVisibility x:Key="EmptyStrVis" />
        <ui:BrushKeyToBrush x:Key="BrushKey" />
        <ui:EnumEquals x:Key="EnumEq" />

        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Brush.Surface}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Line}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="14,13" />
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>

        <!-- Adapter selector.

             Styled rather than left alone because the stock WPF ComboBox carries a 18px gradient
             arrow and a sunken bevel that mark the window as unstyled no matter what surrounds
             it. The list drops down below, its corners match the field, and items take the accent
             only when hovered - the same visual language as the rows underneath it. -->
        <Style x:Key="Combo" TargetType="ComboBox">
            <Setter Property="Background" Value="{DynamicResource Brush.Input}" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.Ink}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Line}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="11,8" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="MaxDropDownHeight" Value="240" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="Toggle"
                                          Focusable="False"
                                          ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="Bd"
                                                Background="{Binding Background, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                BorderBrush="{Binding BorderBrush, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                BorderThickness="1"
                                                CornerRadius="8"
                                                Padding="11,8">
                                            <Viewbox Width="9" Height="6" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                <Path Data="M0,0 L4.5,4 L9,0" Stroke="{DynamicResource Brush.Muted}" StrokeThickness="1.6" />
                                            </Viewbox>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Brush.Line.Strong}" />
                                            </Trigger>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>

                            <!-- Content sits over the toggle and is not hit-testable, so clicks
                                 land on the toggle and open the list either way. -->
                            <ContentPresenter x:Name="ContentSite"
                                              Margin="11,8,32,8"
                                              HorizontalAlignment="Left"
                                              VerticalAlignment="Center"
                                              IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" />

                            <Popup x:Name="PART_Popup"
                                   AllowsTransparency="True"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   Placement="Bottom"
                                   StaysOpen="False"
                                   PopupAnimation="Fade">
                                <Border Margin="0,5,0,0"
                                        Padding="4"
                                        Background="{DynamicResource Brush.Surface}"
                                        BorderBrush="{DynamicResource Brush.Line}"
                                        BorderThickness="1"
                                        CornerRadius="10">
                                    <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                                                  VerticalScrollBarVisibility="Auto">
                                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ComboItem" TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource Brush.Ink}" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="Margin" Value="0,1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="7" Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Hover}" />
                            </Trigger>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Hover}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Accent.Soft}" />
                                <Setter Property="Foreground" Value="{DynamicResource Brush.Accent}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- FlowDirection is applied to this grid in code-behind, not to the Window itself.
         Setting it on the Window makes WPF put WS_EX_LAYOUTRTL on the HWND, and Windows then
         mirrors the title bar caption as well - "DnsPilot" reads backwards in the frame, where
         no amount of work inside the client area can reach it. Scoping it here mirrors the
         layout the same way and leaves the caption alone. -->
    <Grid x:Name="Root" Margin="16,14,16,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header  -->
        <Grid Grid.Row="0" Margin="0,0,0,14">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Border Width="9" Height="9" CornerRadius="5"
                        Margin="0,1,10,0"
                        VerticalAlignment="Top"
                        Background="{DynamicResource Brush.Accent}" />
                <StackPanel>
                    <!-- Pinned LeftToRight: the name is the same Latin word in both languages,
                         and in an RTL window WPF would reverse it to read backwards. -->
                    <TextBlock FlowDirection="LeftToRight"
                               FontFamily="{StaticResource Font.Display}"
                               FontSize="17"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource Brush.Ink}"
                               Text="{Binding [app_name]}" />
                    <TextBlock Margin="0,1,0,0"
                               Style="{StaticResource Text.Muted}"
                               Text="{Binding [app_tagline]}" />
                </StackPanel>
            </StackPanel>

            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center">
                <!-- Automation ids so assistive tech and scripted checks can name these controls
                     rather than inferring them from their glyphs, which change with the language. -->
                <Button Padding="8,6"
                        AutomationProperties.AutomationId="LanguageSwitch"
                        Command="{Binding LanguageCommand}"
                        Content="{Binding SwitchLanguageText}"
                        FontSize="11.5"
                        Style="{StaticResource Btn.Ghost}" />
                <!-- Glyph plus the word it switches to. A lone crescent was too quiet for a
                     control that repaints the whole window, and the word makes the button read
                     as an action rather than a status. -->
                <Button Padding="8,6"
                        AutomationProperties.AutomationId="ThemeSwitch"
                        Command="{Binding ThemeCommand}"
                        FontSize="11.5"
                        Style="{StaticResource Btn.Ghost}"
                        ToolTip="{Binding [theme]}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Margin="0,0,5,0"
                                   FontSize="13"
                                   VerticalAlignment="Center"
                                   Text="{Binding ThemeGlyph}" />
                        <TextBlock VerticalAlignment="Center"
                                   Text="{Binding ThemeToggleText}" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Adapter + family  -->
        <Border Grid.Row="1" Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock Style="{StaticResource Label.Section}" Text="{Binding [adapter]}" />

                <ComboBox ItemContainerStyle="{StaticResource ComboItem}"
                          Style="{StaticResource Combo}"
                          ItemsSource="{Binding Adapters}"
                          SelectedItem="{Binding SelectedAdapter, Mode=TwoWay}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <!-- Adapter names come from Windows and are Latin whatever the UI
                                 language, so both runs are pinned rather than mirrored. -->
                            <StackPanel FlowDirection="LeftToRight" Orientation="Horizontal">
                                <TextBlock FontWeight="SemiBold" Text="{Binding Alias}" />
                                <TextBlock Margin="7,0,0,0"
                                           Foreground="{DynamicResource Brush.Muted}"
                                           Text="{Binding Description}" />
                            </StackPanel>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>

                <!-- Family is a segmented pair rather than a dropdown: two options that change
                     every row below deserve to be visible without a click. -->
                <StackPanel Margin="0,11,0,0" Orientation="Horizontal">
                    <TextBlock Margin="0,0,10,0"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource Brush.Muted}"
                               FontSize="11.5"
                               Text="{Binding [family]}" />
                    <!-- IPv4 and IPv6 are Latin in both languages, so the segmented pair is
                         pinned; without it the labels reverse and read 4vPI / 6vPI. -->
                    <RadioButton FlowDirection="LeftToRight"
                                 GroupName="fam"
                                 IsChecked="{Binding Family, Mode=TwoWay, Converter={StaticResource EnumEq}, ConverterParameter=IPv4}"
                                 IsEnabled="{Binding CanIPv4}"
                                 Content="{Binding [family_ipv4]}"
                                 Style="{StaticResource Tab}" />
                    <RadioButton FlowDirection="LeftToRight"
                                 GroupName="fam"
                                 IsChecked="{Binding Family, Mode=TwoWay, Converter={StaticResource EnumEq}, ConverterParameter=IPv6}"
                                 IsEnabled="{Binding CanIPv6}"
                                 Content="{Binding [family_ipv6]}"
                                 Style="{StaticResource Tab}" />
                </StackPanel>

                <TextBlock Margin="0,7,0,0"
                           Style="{StaticResource Text.Muted}"
                           Text="{Binding [family_unavailable]}"
                           Visibility="{Binding CanIPv6, Converter={StaticResource InvBoolVis}}" />
            </StackPanel>
        </Border>

        <!-- Current state  -->
        <Border Grid.Row="2" Style="{StaticResource Card}">
            <StackPanel>
                <Grid>
                    <TextBlock Style="{StaticResource Label.Section}" Text="{Binding [current]}" />
                    <TextBlock HorizontalAlignment="Right"
                               VerticalAlignment="Top"
                               Foreground="{DynamicResource Brush.Muted}"
                               FontSize="11"
                               Text="{Binding CurrentMode}" />
                </Grid>
                <!-- Monospace, because this is the line being compared against the list below:
                     the same address, in the same pitch, in both places.

                     LeftToRight for the same reason as the addresses below: these are IP
                     addresses, and letting an RTL window order them backwards would print a
                     different address than the one the adapter is using. -->
                <TextBlock FlowDirection="LeftToRight"
                           FontFamily="{StaticResource Font.Mono}"
                           FontSize="13"
                           Foreground="{DynamicResource Brush.Ink}"
                           Text="{Binding CurrentServers}"
                           TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </Border>

        <!-- Search + groups  -->
        <Grid Grid.Row="3" Margin="0,2,0,10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- The placeholder is an overlay that disappears with the first typed character:
                  an empty field used to look like an empty card, with the "Find a server" hint
                  written nowhere and the [search] text key referenced by nothing. -->
            <Grid Grid.Row="0" VerticalAlignment="Top">
                <TextBox Style="{StaticResource Input.Search}"
                         AutomationProperties.AutomationId="SearchField"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Margin="13,9,13,0"
                           VerticalAlignment="Center"
                           IsHitTestVisible="False"
                           FontSize="{StaticResource Size.Small}"
                           Foreground="{DynamicResource Brush.Muted}"
                           Text="{Binding [search]}"
                           Visibility="{Binding SearchText, Converter={StaticResource EmptyStrVis}}" />
            </Grid>

            <Grid Grid.Row="1" Margin="0,9,0,0">
                <StackPanel Orientation="Horizontal">
                    <RadioButton Content="{Binding [group_default]}"
                                 Command="{Binding SelectGroupCommand}"
                                 CommandParameter="default"
                                 GroupName="grp"
                                 IsChecked="{Binding SelectedGroup, Mode=OneWay, Path=IsSelected}"
                                 Style="{StaticResource Tab}" />
                    <RadioButton Content="{Binding [group_family]}"
                                 Command="{Binding SelectGroupCommand}"
                                 CommandParameter="family"
                                 GroupName="grp"
                                 IsChecked="{Binding SelectedGroup, Mode=OneWay, Path=IsSelected}"
                                 Style="{StaticResource Tab}" />
                    <RadioButton Content="{Binding [group_secure]}"
                                 Command="{Binding SelectGroupCommand}"
                                 CommandParameter="secure"
                                 GroupName="grp"
                                 IsChecked="{Binding SelectedGroup, Mode=OneWay, Path=IsSelected}"
                                 Style="{StaticResource Tab}" />
                    <RadioButton Content="{Binding [group_custom]}"
                                 Command="{Binding SelectGroupCommand}"
                                 CommandParameter="custom"
                                 GroupName="grp"
                                 IsChecked="{Binding SelectedGroup, Mode=OneWay, Path=IsSelected}"
                                 Style="{StaticResource Tab}" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Padding="7,6"
                            Click="OnAddClick"
                            Content="+"
                            FontSize="14"
                            FontWeight="Bold"
                            Style="{StaticResource Btn.Ghost}"
                            ToolTip="{Binding [action_add]}" />
                    <Button Padding="7,6"
                            Command="{Binding RemoveCommand}"
                            Content="−"
                            FontSize="14"
                            FontWeight="Bold"
                            IsEnabled="{Binding CanRemoveSelected}"
                            Style="{StaticResource Btn.Ghost}"
                            ToolTip="{Binding [action_delete]}" />
                </StackPanel>
            </Grid>
        </Grid>

        <!-- Server list  -->
        <Grid Grid.Row="4">
            <ListBox x:Name="ServerList"
                     Background="Transparent"
                     BorderThickness="0"
                     HorizontalContentAlignment="Stretch"
                     ItemContainerStyle="{StaticResource Row}"
                     ItemsSource="{Binding VisibleServers}"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     SelectedItem="{Binding SelectedRow, Mode=TwoWay}">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!-- The marker says "this is what your adapter is on now" without
                                 needing a second column of words; it is invisible everywhere else. -->
                            <Border Grid.Column="0"
                                    Width="3"
                                    Margin="0,0,11,0"
                                    CornerRadius="2"
                                    Background="{DynamicResource Brush.Accent}"
                                    Visibility="{Binding IsCurrent, Converter={StaticResource BoolVis}}" />

                            <StackPanel Grid.Column="1">
                                <!-- Server names are Latin in the shipped list and country codes
                                     are two Latin letters, so both are pinned. A name the user
                                     typed in Persian still renders correctly here: pinning fixes
                                     the paragraph direction, and the bidi run inside it keeps
                                     its own direction. -->
                                <StackPanel FlowDirection="LeftToRight" Orientation="Horizontal">
                                    <TextBlock FontWeight="SemiBold"
                                               Text="{Binding Name}"
                                               TextTrimming="CharacterEllipsis" />
                                    <Border Margin="6,0,0,0"
                                            Padding="5,2"
                                            Background="{DynamicResource Brush.Input}"
                                            CornerRadius="4"
                                            Visibility="{Binding HasCountry, Converter={StaticResource BoolVis}}">
                                        <TextBlock Foreground="{DynamicResource Brush.Muted}"
                                                   FontSize="10"
                                                   Text="{Binding Country}" />
                                    </Border>
                                </StackPanel>
                                <StackPanel Margin="0,3,0,0" Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Text.Address}" Text="{Binding Primary}" />
                                    <TextBlock Margin="9,0,0,0"
                                               Style="{StaticResource Text.Address}"
                                               Text="{Binding Secondary}"
                                               Visibility="{Binding HasSecondary, Converter={StaticResource BoolVis}}" />
                                </StackPanel>
                            </StackPanel>

                            <!-- Latency sits on the right in one column, so every number lines up
                                 under the last and the eye can run down them.

                                 MaxWidth is a guard, not a layout choice: the column is Auto, so
                                 anything written into this cell would otherwise claim as much room
                                 as it wanted and squeeze the server name beside it. The longest
                                 string this can show is a few words of mono at 12 px, so 110 is
                                 slack for every current value and a ceiling for any future one. -->
                            <TextBlock Grid.Column="2"
                                       Margin="10,0,0,0"
                                       MaxWidth="110"
                                       VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"
                                       FontFamily="{StaticResource Font.Mono}"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="{Binding LatencyBrush, Converter={StaticResource BrushKey}}"
                                       Text="{Binding LatencyText}" />
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <StackPanel HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Margin="0,4"
                        Visibility="{Binding ListIsEmpty, Converter={StaticResource BoolVis}}">
                <TextBlock HorizontalAlignment="Center"
                           Foreground="{DynamicResource Brush.Muted}"
                           Text="{Binding EmptyListText}"
                           TextWrapping="Wrap"
                           TextAlignment="Center" />
                <Button HorizontalAlignment="Center"
                        Margin="0,11,0,0"
                        Click="OnAddClick"
                        Content="{Binding [action_add]}"
                        Style="{StaticResource Btn.Compact}" />
            </StackPanel>
        </Grid>

        <!-- Actions  -->
        <StackPanel Grid.Row="5" Margin="0,11,0,0">
            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0"
                        AutomationProperties.AutomationId="Apply"
                        Command="{Binding ApplyCommand}"
                        Content="{Binding [action_apply]}"
                        Style="{StaticResource Btn.Primary}" />
                <Button Grid.Column="2"
                        AutomationProperties.AutomationId="ApplyDhcp"
                        Command="{Binding ApplyDhcpCommand}"
                        Content="{Binding [action_apply_dhcp]}"
                        Style="{StaticResource Btn.Base}" />
            </Grid>

            <UniformGrid Columns="3">
                <Button Margin="0,0,7,0"
                        AutomationProperties.AutomationId="TestSpeed"
                        Command="{Binding TestCommand}"
                        Content="{Binding [action_test]}"
                        Style="{StaticResource Btn.Compact}" />
                <Button Margin="0,0,7,0"
                        AutomationProperties.AutomationId="Flush"
                        Command="{Binding FlushCommand}"
                        Content="{Binding [action_flush]}"
                        Style="{StaticResource Btn.Compact}" />
                <Button AutomationProperties.AutomationId="Restore"
                        Command="{Binding RestoreCommand}"
                        Content="{Binding [action_restore]}"
                        Style="{StaticResource Btn.Compact}" />
            </UniformGrid>
        </StackPanel>

        <!-- Status  -->
        <StackPanel Grid.Row="6" Margin="0,11,0,0">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- A small ring rather than an icon: it can spin, and it costs nothing
                         when it is not spinning. -->
                    <Ellipse x:Name="BusyDot"
                             Width="7" Height="7"
                             Margin="0,0,8,0"
                             Fill="{DynamicResource Brush.Accent}"
                             Visibility="{Binding IsBusy, Converter={StaticResource BoolVis}}">
                        <Ellipse.Triggers>
                            <EventTrigger RoutedEvent="Ellipse.Loaded">
                                <BeginStoryboard>
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                         From="1" To="0.25" Duration="0:0:0.6"
                                                         AutoReverse="True" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </Ellipse.Triggers>
                    </Ellipse>
                    <!-- The status text itself carries the test progress ("Measuring 12 of
                         63 servers…"), so a second word here would repeat it; the ring is the
                         only extra cue the test needs. -->
                    <TextBlock x:Name="StatusText"
                               Foreground="{DynamicResource Brush.Muted}"
                               FontSize="11.5"
                               Text="{Binding StatusText}" />
                </StackPanel>

                <Button HorizontalAlignment="Right"
                        Click="OnDetailClick"
                        Content="{Binding [error_detail]}"
                        FontSize="11"
                        Padding="6,2"
                        Style="{StaticResource Btn.Ghost}"
                        Visibility="{Binding HasDetail, Converter={StaticResource BoolVis}}" />
            </Grid>

            <!-- Failure is stated in the window rather than only in a message box, so it is
                 still there to read after the box has been dismissed. -->
            <Border Margin="0,8,0,0"
                    Padding="10,8"
                    Background="{DynamicResource Brush.Surface}"
                    BorderBrush="{DynamicResource Brush.Error}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Visibility="{Binding HasError, Converter={StaticResource BoolVis}}">
                <TextBlock FontSize="11.5"
                           Foreground="{DynamicResource Brush.Error}"
                           Text="{Binding ErrorText}"
                           TextWrapping="Wrap" />
            </Border>
        </StackPanel>

        <!-- Add-server panel  -->
        <Grid x:Name="AddOverlay"
              Grid.Row="0"
              Grid.RowSpan="7"
              Margin="-16,-14,-16,-12"
              Background="#80000000"
              Visibility="Collapsed">
            <Border Margin="22"
                    Padding="18,16"
                    Background="{DynamicResource Brush.Surface}"
                    BorderBrush="{DynamicResource Brush.Line}"
                    BorderThickness="1"
                    CornerRadius="12"
                    VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock FontSize="15"
                               FontWeight="SemiBold"
                               Margin="0,0,0,14"
                               Foreground="{DynamicResource Brush.Ink}"
                               Text="{Binding [add_title]}" />

                    <TextBlock Style="{StaticResource Label.Section}" Text="{Binding [add_name]}" />
                    <TextBox x:Name="AddName"
                             Margin="0,0,0,11"
                             Style="{StaticResource Input.Text}" />

                    <TextBlock Style="{StaticResource Label.Section}" Text="{Binding [add_primary]}" />
                    <TextBox x:Name="AddPrimary"
                             FontFamily="{StaticResource Font.Mono}"
                             Margin="0,0,0,11"
                             Style="{StaticResource Input.Text}" />

                    <TextBlock Style="{StaticResource Label.Section}" Text="{Binding [add_secondary]}" />
                    <TextBox x:Name="AddSecondary"
                             FontFamily="{StaticResource Font.Mono}"
                             Margin="0,0,0,4"
                             Style="{StaticResource Input.Text}" />

                    <StackPanel Margin="0,10,0,0" Orientation="Horizontal">
                        <TextBlock Margin="0,0,8,0" VerticalAlignment="Center"
                                   Foreground="{DynamicResource Brush.Muted}" FontSize="11.5"
                                   Text="{Binding [family]}" />
                        <RadioButton x:Name="AddV4" GroupName="addfam" IsChecked="True"
                                     Content="{Binding [family_ipv4]}"
                                     Style="{StaticResource Tab}" />
                        <RadioButton x:Name="AddV6" GroupName="addfam"
                                     Content="{Binding [family_ipv6]}"
                                     Style="{StaticResource Tab}" />
                    </StackPanel>

                    <TextBlock x:Name="AddError"
                               Margin="0,10,0,0"
                               FontSize="11.5"
                               Foreground="{DynamicResource Brush.Error}"
                               TextWrapping="Wrap"
                               Visibility="Collapsed" />

                    <Grid Margin="0,16,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0"
                                Click="OnAddCancel"
                                Content="{Binding [action_cancel]}"
                                Style="{StaticResource Btn.Base}" />
                        <Button Grid.Column="2"
                                Click="OnAddSave"
                                Content="{Binding [action_save]}"
                                Style="{StaticResource Btn.Primary}" />
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
