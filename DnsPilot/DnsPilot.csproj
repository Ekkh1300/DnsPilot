<Project Sdk="Microsoft.NET.Sdk">

  <!--
    DnsPilot - a small DNS switcher for Windows.

    Deliberately narrow: it changes which resolver the machine asks, shows which answer fastest,
    and puts the original back. Nothing else. It is not a tunnel and does not move any other
    traffic.

    WPF on net8.0-windows because that is what this machine can build, run and test, so every
    claim about it can be checked rather than assumed. UseWindowsForms is on for one reason only:
    the tray icon. NotifyIcon is the supported way to have one and WPF has no equivalent.

    Elevated, because changing DNS is a privileged operation - netsh and the Tcpip registry key
    both refuse without it. That means one UAC prompt at start rather than a second one at the
    moment of the first change, which is the better of the two surprises.
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>DnsPilot</RootNamespace>
    <AssemblyName>DnsPilot</AssemblyName>
    <Version>1.0.0</Version>
    <LangVersion>latest</LangVersion>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!--
      The app has one icon and every surface shows it: the title bar, the taskbar, Alt-Tab, the
      tray and Explorer. It is a generated file (tools\New-Icon.ps1 draws it from geometry), so
      the brand colour lives in that script rather than in binary artwork nobody can edit.
      ApplicationIcon puts it in the exe's Win32 resources; the Resource item below is what makes
      Icon= in XAML and the tray NotifyIcon read the very same file instead of a second copy.
    -->
    <ApplicationIcon>Assets\dns-pilot.ico</ApplicationIcon>
    <AssemblyTitle>DnsPilot</AssemblyTitle>
    <Product>DnsPilot</Product>
    <Description>Switch DNS servers on a network adapter</Description>

    <!--
      WFAC010 asks for the high-DPI declaration to move out of app.manifest and into
      ApplicationHighDpiMode. That advice is correct for a WinForms app and wrong here: this is a
      WPF window, WPF reads DPI awareness from the manifest, and ApplicationHighDpiMode configures
      WinForms only - which in this project is a tray icon with no rendered surface of its own.
      Following the suggestion would leave the window scaling by whatever the OS decides when a
      manifest says nothing, which on a scaled display means blur. The manifest stays.
    -->
    <NoWarn>$(NoWarn);WFAC010</NoWarn>
  </PropertyGroup>

  <!-- Presets are data, not code, so they ship as one file the app reads at start. -->
  <ItemGroup>
    <EmbeddedResource Include="Data\presets.json" />
  </ItemGroup>

  <!--
    The icon. Resource (not Content, not EmbeddedResource) so WPF compiles it into the assembly
    and a pack URI can reach it: Window.Icon takes it for the title bar, and the tray reads the
    same bytes at runtime. Shipping it as a loose file instead would mean the exe could lose its
    own icon the moment a copy step was forgotten.
  -->
  <ItemGroup>
    <None Remove="Assets\dns-pilot.ico" />
    <Resource Include="Assets\dns-pilot.ico" />
  </ItemGroup>

  <!--
    The installer lives beside the app because it installs the app, but it is a different program
    with a different target: Setup.cs is C# 5, compiled by the Windows-bundled csc against
    .NET Framework, and none of it belongs in a net8.0-windows build. SDK projects glob every .cs
    under the project folder, so leaving it in would compile WinForms installer code into the app
    and drag its twenty-odd nullability warnings into this project's warning count. It is built by
    installer\build.ps1 instead.
  -->
  <ItemGroup>
    <Compile Remove="installer\**\*.cs" />
    <None Include="installer\**" />
  </ItemGroup>

</Project>
